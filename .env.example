DATABASE_URL="sqlserver://localhost:14331;database=library_lms;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
AUTH_SECRET="generate-a-stable-random-secret"

# Optional public site URL used for metadata. Safe to expose in the browser.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Google OAuth credentials. Add this exact URI to the OAuth client's
# Authorized redirect URIs in Google Cloud Console when the app runs on port 3000:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional initial administrator, created by `npm run db:seed`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Library Admin"

# Optional Sentry error monitoring. NEXT_PUBLIC_* values are visible in the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-side Sentry DSN; keep this value server-only.
SENTRY_DSN=

# Optional comma-separated exact hosts for Server Action CSRF when a reverse
# proxy reports a different Host than the browser Origin (no wildcards).
# Example: books.example.com,books.example.com:8443
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Optional Upstash Redis for distributed rate limiting across multiple Node
# instances. Without these, the app uses an in-process limiter (single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Analytics: Google Analytics 4 & PostHog
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Optional Cloud File Uploads (S3, Cloudinary, UploadThing)
AWS_S3_BUCKET=
AWS_REGION="us-east-1"
NEXT_PUBLIC_CDN_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_SECRET=
